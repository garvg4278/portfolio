---
import { site } from '../data/site';
const { path = '/' } = Astro.props;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav" id="top">
  <div class="nav__bar">
    <a class="brand" href="/" aria-label="Garv Gupta, home">
      <svg viewBox="0 0 28 22" width="26" height="20" aria-hidden="true"><path d="M3 6 14 1l11 5-11 5Z" fill="#C8B8DB"/><path d="M3 11.5 14 6.5l11 5-11 5Z" fill="#70587C"/><path d="M3 17 14 12l11 5-11 5Z" fill="#502F4C"/></svg>
      <span>Garv Gupta</span>
    </a>
    <nav aria-label="Primary" class="nav__links" id="menu">
      <ul>
        {site.nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--ghost nav__cta" href={site.resume} download>Resume</a>
    </nav>
    <div class="nav__tools">
      <button class="theme" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false">
        <svg class="theme__moon" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M16.5 11.5A6.5 6.5 0 0 1 8.5 3.5a6.5 6.5 0 1 0 8 8Z"/></svg>
        <svg class="theme__sun" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4"/></svg>
      </button>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h); background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); border-bottom: 1px solid var(--line); }
  .nav__bar { max-width: calc(var(--max) + var(--gutter) * 2); margin-inline: auto; padding-inline: var(--gutter); height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; font-family: var(--font-display); font-size: 1.55rem; letter-spacing: -0.01em; line-height: 1; }
  .brand svg { transition: transform var(--t-med) var(--ease); }
  .brand:hover svg { transform: translateY(-2px); }
  .nav__links { display: flex; align-items: center; gap: 1.5rem; }
  .nav__links ul { display: flex; gap: 0.25rem; }
  .nav__links ul a { position: relative; display: block; padding: 0.55rem 0.85rem; text-decoration: none; font-size: 0.95rem; color: var(--text-dim); }
  .nav__links ul a::after { content: ''; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.25rem; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--t-med) var(--ease); }
  .nav__links ul a:hover, .nav__links ul a[aria-current='page'] { color: var(--text); }
  .nav__links ul a:hover::after, .nav__links ul a[aria-current='page']::after { transform: scaleX(1); }
  :global(:root[data-theme='light']) .nav { background: color-mix(in srgb, var(--bg) 93%, transparent); }
  .nav__tools { display: flex; align-items: center; gap: 0.5rem; }
  .theme { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--text-dim); transition: color var(--t-fast), border-color var(--t-fast), transform var(--t-med) var(--ease); }
  .theme:hover { color: var(--accent); border-color: var(--accent); transform: rotate(-12deg); }
  .theme__sun { display: none; }
  :global(:root[data-theme='light']) .theme__sun { display: block; }
  :global(:root[data-theme='light']) .theme__moon { display: none; }
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .nav__cta { min-height: 40px; padding: 0.45rem 1rem; font-size: 0.9rem; }
  .nav__toggle { display: none; width: 48px; height: 48px; background: none; border: 1px solid var(--line); border-radius: var(--r-sm); position: relative; }
  .nav__toggle span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--fg); transition: transform var(--t-med) var(--ease), top var(--t-med) var(--ease); }
  .nav__toggle span:first-child { top: 19px; }
  .nav__toggle span:last-child { top: 28px; }
  .nav__toggle[aria-expanded='true'] span:first-child { top: 23.5px; transform: rotate(45deg); }
  .nav__toggle[aria-expanded='true'] span:last-child { top: 23.5px; transform: rotate(-45deg); }
  @media (max-width: 900px) {
    .nav__toggle { display: block; }
    .nav__links { position: fixed; inset: var(--nav-h) 0 auto 0; flex-direction: column; align-items: stretch; gap: 1.25rem; padding: 1.25rem var(--gutter) 2rem; background: color-mix(in srgb, var(--aubergine) 28%, var(--bg)); border-bottom: 1px solid var(--line-strong); transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity var(--t-med) var(--ease), transform var(--t-med) var(--ease), visibility 0s linear var(--t-med); max-height: calc(100svh - var(--nav-h)); overflow-y: auto; }
    .nav__links[data-open='true'] { opacity: 1; transform: none; visibility: visible; transition-delay: 0s; }
    .nav__links ul { flex-direction: column; }
    .nav__links ul a { font-size: 1.35rem; font-family: var(--font-display); padding: 0.8rem 0; min-height: 48px; color: var(--text); }
    .nav__links ul a::after { left: 0; right: auto; width: 3rem; bottom: 0.45rem; }
  }
</style>

<script>
  import { initNav } from '../scripts/features/nav.js';
  initNav();
</script>
