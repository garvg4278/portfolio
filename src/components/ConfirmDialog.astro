---
// One shared confirmation dialog. Open it from scripts with confirmAction() in src/scripts/features/confirm.js.
---
<dialog class="confirm" id="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <form method="dialog">
    <h2 id="confirm-title" data-title>Are you sure?</h2>
    <p class="dim" id="confirm-message" data-message></p>
    <div class="confirm__actions">
      <button class="btn btn--ghost" type="submit" value="cancel" data-cancel autofocus>Cancel</button>
      <button class="btn" type="submit" value="confirm" data-confirm>Confirm</button>
    </div>
  </form>
</dialog>

<style>
  .confirm { width: min(30rem, 92vw); padding: 1.5rem; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--bg); color: var(--fg); box-shadow: var(--shadow-layer); }
  .confirm::backdrop { background: color-mix(in srgb, #000 70%, transparent); backdrop-filter: blur(3px); }
  .confirm h2 { font-size: 1.9rem; margin-bottom: 0.6rem; }
  .confirm__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }
</style>

<script>
  import { initConfirmDialog } from '../scripts/features/confirm.js';
  initConfirmDialog();
</script>
