---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import { site } from '../data/site';
const { title, description = site.description, path = '/', jsonLd, noindex = false } = Astro.props;
const fullTitle = path === '/' ? title : `${title} | ${site.name}`;
const canonical = new URL(path, site.url).href;
const og = new URL('/og.png', site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      // Runs before first paint: mark JS as available and apply the saved theme (dark by default) without a flash.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = 'dark';
        try { if (localStorage.getItem('theme') === 'light') t = 'light'; } catch (e) {}
        d.dataset.theme = t;
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav path={path} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <button class="totop" type="button" data-totop hidden aria-label="Back to top">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5"/></svg>
    </button>
    <p id="live-status" class="sr-only" role="status" aria-live="polite"></p>
    <ConfirmDialog />
    <script>
      import { initReveal, initTilt } from '../scripts/features/effects.js';
      import { initThemeToggle } from '../scripts/features/theme.js';
      import { initScrollChrome } from '../scripts/features/chrome.js';
      import { initCopyButtons } from '../scripts/features/copy.js';
      initReveal();
      initTilt();
      initThemeToggle();
      initScrollChrome();
      initCopyButtons();
</script>
  </body>
</html>
