# Public build-time settings. Copy to .env if you need them. Values are embedded in the built site: never put secrets here.

# Canonical origin used for canonical links, Open Graph tags and the sitemap.
PUBLIC_SITE_URL=https://garv-gupta-portfolio.pages.dev

# Optional form-service endpoint (for example a Formspree URL). Leave empty to use the mailto fallback.
PUBLIC_FORM_ENDPOINT=
